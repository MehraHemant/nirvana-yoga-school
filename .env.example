# Database (Neon Postgres)
# Keep the Neon connection string server-only. Runtime queries use
# @neondatabase/serverless for runtime CMS queries.
NEON_DB_POSTGRES_URL=postgresql://user:password@your-neon-host/neondb?sslmode=require

# Admin session signing (change in production)
ADMIN_JWT_SECRET=change-me-in-production

# Cloudinary image CDN (admin uploads, max 1MB server-side)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
# Optional folder prefix for uploads (default: nirvana-cms)
CLOUDINARY_UPLOAD_FOLDER=nirvana-cms

# PayPal (book-now flow — same as live site)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_MODE=sandbox

# Public site AI chatbot (Gemini + Qdrant vector RAG)
# Apply schema once: npm run db:migrate:chat
# PDF knowledge table: npm run db:migrate:chat-pdfs
# Index live CMS + PDFs into Qdrant: npm run db:index:chat
# (also available in CMS → Chat index)
# Absolute links in chat answers use request origin, then:
# NEXT_PUBLIC_SITE_URL=https://www.nirvanayogaschoolindia.com
GEMINI_API_KEY=your-gemini-api-key
# Optional model override (default: gemini-flash-lite-latest)
# GEMINI_MODEL=gemini-flash-lite-latest
# Optional comma-separated chat fallbacks on 429/quota (defaults: gemini-2.5-flash-lite,gemini-2.5-flash,gemini-3.1-flash-lite)
# GEMINI_MODEL_FALLBACKS=gemini-2.5-flash-lite,gemini-2.5-flash,gemini-3.1-flash-lite
# GEMINI_EMBED_MODEL=gemini-embedding-001
#
# Qdrant (vector store for chat RAG)
QDRANT_URL=http://127.0.0.1:6333
# QDRANT_API_KEY=
# QDRANT_COLLECTION=nirvana_chat_chunks
# Must match embed outputDimensionality (gemini-embedding-001 default here: 768)
# QDRANT_VECTOR_SIZE=768


# Database (MySQL — Hostinger or local docker compose)
DATABASE_URL=mysql://nirvana:nirvana@localhost:3306/nirvana_cms

# Admin session signing (change in production)
ADMIN_JWT_SECRET=change-me-in-production

# Cloudinary image CDN (admin uploads, max 500KB server-side)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
# Optional folder prefix for uploads (default: nirvana-cms)
CLOUDINARY_UPLOAD_FOLDER=nirvana-cms
# PayPal (book-now flow — same as live site)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_MODE=sandbox

# Ollama (local AI — chatbot RAG)
# Use Docker Ollama (recommended): npm run ollama:up && npm run ollama:pull
# Stop any broken system `ollama serve` on :11434 before switching.
OLLAMA_BASE_URL=http://localhost:11435
OLLAMA_CHAT_MODEL=llama3.2:1b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Chatbot rate limiting (requests per window per IP)
CHAT_RATE_LIMIT_MAX=30
CHAT_RATE_LIMIT_WINDOW_MS=60000
CHAT_ADMIN_UPLOAD_RATE_LIMIT_MAX=15
CHAT_ADMIN_UPLOAD_RATE_WINDOW_MS=900000

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum PageType {
  course
  online
  retreat
  venue
  site
  blog
}

enum AdminRole {
  admin
  editor
}

enum NavItemType {
  page
  static
}

enum LeadType {
  enquiry
  contact
}

enum LeadStatus {
  new
  read
  replied
  archived
}

enum BookingType {
  course
  retreat
}

enum BookingStatus {
  pending_payment
  confirmed
  failed
  cancelled
}

enum PaymentMode {
  full
  deposit_20
}

model Page {
  id            String   @id @default(cuid())
  slug          String   @unique
  type          PageType
  eyebrow       String   @default("")
  title         String
  description   String   @default("") @db.Text
  image         String   @default("") @db.VarChar(500)
  /// Denormalized from hero for admin section lists (no JSON parse)
  fee           String   @default("")
  duration      String   @default("")
  ctaLabel      String?  @map("cta_label")
  ctaHref       String?  @map("cta_href")
  published     Boolean  @default(true)
  /// Content type assigned to this page (Contentful-style content model)
  contentTypeId String?  @map("content_type_id")
  /// Field values for the assigned content type
  contentData   Json     @default("{}") @map("content_data")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  sections    PageSection[]
  packages    PagePackage[]
  gallery     PageGalleryImage[]
  cards       PageCard[]
  people      PagePerson[]
  highlights  PageHighlight[]
  courseDoc   CourseDocument?
  pageModules Json?              @map("page_modules")
  contentType ContentType?       @relation(fields: [contentTypeId], references: [id], onDelete: SetNull)

  @@index([type, published])
  @@index([type, title])
  @@index([updatedAt])
  @@index([contentTypeId])
  @@map("pages")
}

// ---------------------------------------------------------------------------
// Contentful-style content model — content type → assign to page → fill fields
// ---------------------------------------------------------------------------

/// Content model (schema). Fields drive the page content editor and public renderer.
model ContentType {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String   @default("") @db.Text
  /// Optional icon key for admin (e.g. "page", "landing", "contact")
  icon        String   @default("page")
  sortOrder   Int      @default(0) @map("sort_order")
  /// Seeded / system types — hide hard-delete in UI when true
  isSystem    Boolean  @default(false) @map("is_system")
  /// Page kinds this component applies to: ["course"], ["site"], …
  pageTypes   Json     @default("[\"site\"]") @map("page_types")
  /// ContentFieldDefinition[] — Short text, Long text, Rich text, etc.
  fields      Json     @default("[]")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  pages Page[]
  items ContentItem[]

  @@index([sortOrder])
  @@map("content_types")
}

// ---------------------------------------------------------------------------
// Headless content model (CH ONE style) — every section is a ContentItem;
// items reference other items via ContentReference (ordered edges).
// ---------------------------------------------------------------------------

/// A single instance of a ContentType. Routable items (pages) set a slug;
/// component items leave it null and are linked from a page via references.
model ContentItem {
  id            String    @id @default(cuid())
  contentTypeId String    @map("content_type_id")
  /// Unique when set — only routable (page) items have a slug.
  slug          String?   @unique
  /// Admin-facing label (page title or component name).
  name          String
  published     Boolean   @default(false)
  publishedAt   DateTime? @map("published_at")
  /// Manual display order within a content type (0, 10, 20…).
  sortOrder     Int       @default(0) @map("sort_order")
  /// Field values keyed by field key (scalars, media urls/ids, reference id arrays).
  data          Json      @default("{}")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  contentType ContentType        @relation(fields: [contentTypeId], references: [id], onDelete: Cascade)
  refsOut     ContentReference[] @relation("refFrom")
  refsIn      ContentReference[] @relation("refTo")

  @@index([contentTypeId, published])
  @@index([contentTypeId, sortOrder])
  @@index([updatedAt])
  @@map("content_items")
}

/// Ordered edge between two content items for a given reference field.
/// `to` uses RESTRICT so a referenced item cannot be hard-deleted.
model ContentReference {
  id        String @id @default(cuid())
  fromId    String @map("from_id")
  toId      String @map("to_id")
  fieldKey  String @map("field_key")
  sortOrder Int    @default(0) @map("sort_order")

  from ContentItem @relation("refFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to   ContentItem @relation("refTo", fields: [toId], references: [id], onDelete: Restrict)

  @@index([toId])
  @@index([fromId, fieldKey, sortOrder])
  @@map("content_references")
}

model PageSection {
  id        String  @id @default(cuid())
  pageId    String  @map("page_id")
  sortOrder Int     @map("sort_order")
  title     String
  eyebrow   String?
  body      String? @db.Text
  layout    String  @default("default")
  image     String?
  images    Json    @default("[]")
  blocks    Json?

  page        Page                @relation(fields: [pageId], references: [id], onDelete: Cascade)
  subsections SectionSubsection[]
  items       SectionItem[]

  @@index([pageId, sortOrder])
  @@map("page_sections")
}

model SectionSubsection {
  id        String  @id @default(cuid())
  sectionId String  @map("section_id")
  sortOrder Int     @map("sort_order")
  title     String
  body      String? @db.Text
  image     String?

  section PageSection      @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  items   SubsectionItem[]

  @@index([sectionId, sortOrder])
  @@map("section_subsections")
}

model SectionItem {
  id        String @id @default(cuid())
  sectionId String @map("section_id")
  sortOrder Int    @map("sort_order")
  value     String

  section PageSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId, sortOrder])
  @@map("section_items")
}

model SubsectionItem {
  id           String @id @default(cuid())
  subsectionId String @map("subsection_id")
  sortOrder    Int    @map("sort_order")
  value        String

  subsection SectionSubsection @relation(fields: [subsectionId], references: [id], onDelete: Cascade)

  @@index([subsectionId, sortOrder])
  @@map("subsection_items")
}

model PagePackage {
  id        String  @id @default(cuid())
  pageId    String  @map("page_id")
  sortOrder Int     @map("sort_order")
  title     String
  price     String
  image     String?

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, sortOrder])
  @@map("page_packages")
}

model PageGalleryImage {
  id           String  @id @default(cuid())
  pageId       String  @map("page_id")
  sortOrder    Int     @map("sort_order")
  url          String
  category     String  @default("general")
  mediaAssetId String? @map("media_asset_id")

  page       Page        @relation(fields: [pageId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset? @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)

  @@index([pageId, sortOrder])
  @@map("page_gallery_images")
}

model PageCard {
  id          String  @id @default(cuid())
  pageId      String  @map("page_id")
  sortOrder   Int     @map("sort_order")
  title       String
  description String  @db.Text
  href        String?

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, sortOrder])
  @@map("page_cards")
}

model PagePerson {
  id         String  @id @default(cuid())
  pageId     String  @map("page_id")
  sortOrder  Int     @map("sort_order")
  name       String
  image      String?
  summary    String? @db.Text
  bio        String? @db.Text
  education  Json    @default("[]")
  experience Json    @default("[]")
  expertise  Json    @default("[]")

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, sortOrder])
  @@map("page_people")
}

model PageHighlight {
  id          String  @id @default(cuid())
  pageId      String  @map("page_id")
  sortOrder   Int     @map("sort_order")
  title       String
  description String  @db.Text
  image       String?

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, sortOrder])
  @@map("page_highlights")
}

model CourseDocument {
  id       String @id @default(cuid())
  pageId   String @unique @map("page_id")
  document Json

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@map("course_documents")
}

model BlogPost {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  category    String    @default("")
  excerpt     String    @db.Text
  image       String    @default("")
  publishedAt DateTime? @map("published_at")
  content     Json      @default("[]")
  bodyHtml    String?   @map("body_html") @db.Text
  published   Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([published, publishedAt])
  @@index([updatedAt])
  @@map("blog_posts")
}

model NavigationGroup {
  id    String @id @default(cuid())
  key   String @unique
  label String

  items NavigationItem[]

  @@map("navigation_groups")
}

model NavigationItem {
  id        String      @id @default(cuid())
  groupId   String      @map("group_id")
  sortOrder Int         @map("sort_order")
  itemType  NavItemType @map("item_type")
  pageType  String?     @map("page_type")
  pageSlug  String?     @map("page_slug")
  href      String?
  label     String?

  group NavigationGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, sortOrder])
  @@index([pageSlug])
  @@map("navigation_items")
}

model MediaAsset {
  id          String   @id @default(cuid())
  url         String
  cdnKey      String   @map("cdn_key")
  mime        String
  sizeBytes   Int      @map("size_bytes")
  width       Int?
  height      Int?
  alt         String?
  caption     String?
  description String?  @db.Text
  tags        Json     @default("[]")
  createdAt   DateTime @default(now()) @map("created_at")

  galleryImages PageGalleryImage[]

  @@index([cdnKey])
  @@index([createdAt])
  @@map("media_assets")
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  role         AdminRole @default(editor)
  createdAt    DateTime  @default(now()) @map("created_at")

  revisions ContentRevision[]

  @@map("admin_users")
}

model ContentRevision {
  id          String   @id @default(cuid())
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  slug        String?
  snapshot    Json
  adminUserId String?  @map("admin_user_id")
  createdAt   DateTime @default(now()) @map("created_at")

  adminUser AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([slug])
  @@map("content_revisions")
}

model ModuleLibraryItem {
  id        String   @id @default(cuid())
  moduleKey String   @map("module_key")
  variant   String?
  name      String
  payload   Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([moduleKey, variant])
  @@map("module_library_items")
}

model LeadSubmission {
  id            String     @id @default(cuid())
  type          LeadType
  status        LeadStatus @default(new)
  name          String
  email         String
  phone         String?
  subject       String?
  program       String?
  accommodation String?
  startDate     String?    @map("start_date")
  message       String     @db.Text
  source        String?
  createdAt     DateTime   @default(now()) @map("created_at")
  readAt        DateTime?  @map("read_at")
  deletedAt     DateTime?  @map("deleted_at")

  @@index([type, createdAt])
  @@index([status, createdAt])
  @@index([deletedAt])
  @@map("lead_submissions")
}

model Booking {
  id               String        @id @default(cuid())
  type             BookingType
  status           BookingStatus @default(pending_payment)
  programSlug      String        @map("program_slug")
  programTitle     String        @map("program_title")
  roomType         String        @map("room_type")
  batchDate        String        @map("batch_date")
  duration         String?
  name             String
  gender           String
  email            String
  phone            String
  country          String?
  referenceCode    String?       @map("reference_code")
  hearAbout        String?       @map("hear_about")
  paymentMode      PaymentMode   @map("payment_mode")
  basePriceCents   Int           @map("base_price_cents")
  fullAmountCents  Int           @map("full_amount_cents")
  payNowCents      Int           @map("pay_now_cents")
  paypalFeeCents   Int           @map("paypal_fee_cents")
  totalPayNowCents Int           @map("total_pay_now_cents")
  remainingCents   Int           @map("remaining_cents")
  promoCode        String?       @map("promo_code")
  discountCents    Int           @default(0) @map("discount_cents")
  paypalOrderId    String?       @map("paypal_order_id")
  paypalCaptureId  String?       @map("paypal_capture_id")
  deletedAt        DateTime?     @map("deleted_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  confirmedAt      DateTime?     @map("confirmed_at")

  @@index([type, status, createdAt])
  @@index([programSlug])
  @@index([deletedAt])
  @@map("bookings")
}

// ---------------------------------------------------------------------------
// Global Settings — header, footer, site-wide config (editable in admin)
// ---------------------------------------------------------------------------

model GlobalSettings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("global_settings")
}
